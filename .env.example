# Copia este archivo a .env.local y completa con tus llaves reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# Access Key de https://web3forms.com (gratis, se obtiene con tu correo)
VITE_WEB3FORMS_ACCESS_KEY=

# Opcional: Site Key de tu propia cuenta de hCaptcha (solo aplica si
# actualizas Web3Forms a un plan de pago). En el plan gratuito, Web3Forms
# usa su propia Site Key compartida automáticamente — no necesitas
# configurar esta variable para que el captcha funcione.
VITE_HCAPTCHA_SITE_KEY=
